# Analytics — defaults are baked into src/config/site.ts, override here if the
# properties change.
NEXT_PUBLIC_GA_ID=G-3F2DSRTZ9P
NEXT_PUBLIC_GTM_ID=GTM-MMZVGMSM

# Google Search Console verification token for responsivedevices.com.
# The pre-rebrand token was bound to responsihub.com and will not validate on
# the new domain. Verify the new property, then set this in the Vercel project.
# Left unset, the verification meta tag is omitted entirely.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
